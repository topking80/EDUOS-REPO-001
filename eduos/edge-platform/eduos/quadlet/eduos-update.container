# EduOS Update Orchestrator - Quadlet version

[Unit]
Description=EduOS Update Policy Agent
Documentation=https://eduos.local/docs/update
After=network-online.target eduos-health.service

[Container]
Image=quay.io/eduos/eduos-update:latest
Volume=/var/lib/eduos/updates:/var/lib/eduos/updates:Z
Volume=/etc/eduos/update-policy.toml:/etc/eduos/update-policy.toml:ro,Z

[Install]
WantedBy=multi-user.target
