# EduOS Bootstrap - Quadlet version
# Place in /etc/containers/systemd/ on CoreOS-based systems

[Unit]
Description=EduOS Bootstrap Service (Quadlet)
Documentation=https://eduos.local/docs/bootstrap
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/eduos/bootstrap-done

[Container]
Image=quay.io/eduos/eduos-bootstrap:latest
Exec=/usr/local/bin/eduos-bootstrap.sh
Volume=/etc/eduos:/etc/eduos:Z
Volume=/var/lib/eduos:/var/lib/eduos:Z
Environment=EDUOS_ROLE_FILE=/etc/eduos/role

[Install]
WantedBy=multi-user.target default.target
