variant: fcos
version: 1.5.0
# metadata:
#   name: eduos-edge-quadlet
#   labels:
#     role: edge
#     feature: quadlet
#     version: "0.2.0"

passwd:
  users:
    - name: edge
      uid: 1003
      gecos: "EduOS Edge Node (with Quadlet)"
      groups: [ wheel ]

storage:
  files:
    - path: /etc/eduos/role
      mode: 0644
      contents:
        inline: |
          edge

    # Include Quadlet definitions (these will be picked up by systemd)
    - path: /etc/containers/systemd/eduos-bootstrap.container
      mode: 0644
      contents:
        local: quadlet/eduos-bootstrap.container

    - path: /etc/containers/systemd/eduos-health.container
      mode: 0644
      contents:
        local: quadlet/eduos-health.container

    - path: /etc/containers/systemd/eduos-update.container
      mode: 0644
      contents:
        local: quadlet/eduos-update.container

    # Scripts still needed for the containers to exec
    - path: /usr/local/bin/eduos-bootstrap.sh
      mode: 0755
      contents:
        local: scripts/eduos-bootstrap.sh

    - path: /usr/local/bin/eduos-health.sh
      mode: 0755
      contents:
        local: scripts/eduos-health.sh

    - path: /usr/local/bin/eduos-update.sh
      mode: 0755
      contents:
        local: scripts/eduos-update.sh

systemd:
  units:
    - name: eduos-bootstrap.service
      enabled: true
      contents_local: services/bootstrap.service
    - name: eduos-health.service
      enabled: true
      contents_local: services/health.service
    - name: eduos-update.service
      enabled: true
      contents_local: services/update.service

    # Enable podman-auto-update timer (optional but recommended with Quadlet)
    - name: podman-auto-update.timer
      enabled: true

ignition:
  config:
    merge:
      - local: ignition/base.ign
