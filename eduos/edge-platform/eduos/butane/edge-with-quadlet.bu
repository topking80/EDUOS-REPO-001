variant: fcos
version: 1.5.0
# metadata:
#   name: eduos-edge-quadlet
#   labels:
#     role: edge
#     feature: quadlet
#     version: "0.2.0"

passwd:
  users:
    - name: edge
      uid: 1003
      gecos: "EduOS Edge Node (with Quadlet)"
      groups: [ wheel ]

storage:
  files:
    - path: /etc/eduos/role
      mode: 0644
      contents:
        inline: |
          edge

    # Include Quadlet definitions (these will be picked up by systemd).
    # Bootstrap is not one of them: it provisions the host (users, /run,
    # systemd units), so it runs as the host unit below, under its
    # NoNewPrivileges/ProtectSystem limits. There is no root container.
    - path: /etc/containers/systemd/eduos-health.container
      mode: 0644
      contents:
        local: quadlet/eduos-health.container

    - path: /usr/local/bin/eduos-bootstrap.sh
      mode: 0755
      contents:
        local: scripts/eduos-bootstrap.sh

systemd:
  units:
    - name: eduos-bootstrap.service
      enabled: true
      contents_local: services/bootstrap.service
    # eduos-health.service comes from the Quadlet file above (container form);
    # a host unit with the same name would override it.

    # Enable podman-auto-update timer (optional but recommended with Quadlet)
    - name: podman-auto-update.timer
      enabled: true

ignition:
  config:
    merge:
      - local: ignition/base.ign
