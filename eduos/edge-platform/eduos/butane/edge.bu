variant: fcos
version: 1.5.0
# metadata:
#   name: eduos-edge
#   labels:
#     role: edge
#     version: "0.2.0"

passwd:
  users:
    - name: edge
      uid: 1003
      gecos: "EduOS Edge / Classroom Hub"
      groups: [ wheel ]
      password_hash: "@@EDUOS_EDGE_PASSWORD_HASH@@"   # supplied at build time (docs/BUILD.md)

storage:
  files:
    - path: /etc/eduos/role
      mode: 0644
      contents:
        inline: |
          edge

    - path: /etc/eduos/edge-config.json
      mode: 0644
      contents:
        inline: |
          {"role":"classroom-edge","local_cache_gb":50,"pxe_enabled":true}

    - path: /usr/local/bin/eduos-bootstrap.sh
      mode: 0755
      contents:
        local: scripts/eduos-bootstrap.sh

    - path: /usr/local/bin/eduos-health.sh
      mode: 0755
      contents:
        local: scripts/eduos-health.sh

systemd:
  units:
    - name: eduos-bootstrap.service
      enabled: true
      contents_local: services/bootstrap.service
    - name: eduos-health.service
      enabled: true
      contents_local: services/health.service

ignition:
  config:
    merge:
      - local: ignition/base.ign
