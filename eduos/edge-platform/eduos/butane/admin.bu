variant: fcos
version: 1.5.0
# metadata:
#   name: eduos-admin
#   labels:
#     role: admin
#     version: "0.2.0"

passwd:
  users:
    - name: admin
      uid: 1000
      gecos: "EduOS School Administrator"
      groups: [ wheel, adm, systemd-journal ]
      password_hash: "@@EDUOS_ADMIN_PASSWORD_HASH@@"   # supplied at build time (docs/BUILD.md)
      ssh_authorized_keys:
        - "@@EDUOS_ADMIN_SSH_KEYS@@"

storage:
  files:
    - path: /etc/eduos/role
      mode: 0644
      contents:
        inline: |
          admin

    - path: /usr/local/bin/eduos-bootstrap.sh
      mode: 0755
      contents:
        local: scripts/eduos-bootstrap.sh

    - path: /usr/local/bin/eduos-health.sh
      mode: 0755
      contents:
        local: scripts/eduos-health.sh

    - path: /usr/local/bin/eduos-update.sh
      mode: 0755
      contents:
        local: scripts/eduos-update.sh

systemd:
  units:
    - name: eduos-bootstrap.service
      enabled: true
      contents_local: services/bootstrap.service
    - name: eduos-health.service
      enabled: true
      contents_local: services/health.service
    - name: eduos-update.service
      enabled: true
      contents_local: services/update.service

ignition:
  config:
    merge:
      - local: ignition/base.ign
