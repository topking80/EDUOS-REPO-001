# EduOS 32.7.0 school node settings. Copy to node.env, chmod 600, fill in.
# Values in <> are placeholders: the node refuses to start without real ones.
POSTGRES_USER=eduos_admin
POSTGRES_PASSWORD=<openssl rand -hex 24>
EDUOS_OWNER_PASSWORD=<openssl rand -hex 24>
EDUOS_APP_PASSWORD=<openssl rand -hex 24>
EDUOS_SITE_ADDRESS=<riverside-elem.node.district.example>
PUBLIC_ORIGIN=https://<riverside-elem.node.district.example>
# District identity provider (new sign-ins need it; signed-in staff keep working offline).
OIDC_ISSUER=<https://idp.district.example>
OIDC_CLIENT_ID=<client id registered for this node>
OIDC_CLIENT_SECRET=<secret>
OIDC_REDIRECT_URI=https://<riverside-elem.node.district.example>/auth/callback
# Staff stay signed in through an outage of up to a school day.
SESSION_IDLE_MINUTES=480
# EDEN: pinned trust root (from the district; `authority-cli.js env`), district hub, school.
EDEN_ROOT_CERT=<base64 root certificate>
EDEN_HUB_URL=https://<hub.district.example>
EDEN_DISTRICT_ID=<district uuid>
EDEN_SCHOOL_ID=<school uuid>
EDEN_NODE_NAME=<Riverside Elementary node>
# One-time, 24 h token from the hub's Nodes screen. Remove after the first start.
EDEN_ENROLLMENT_TOKEN=<token>
EDEN_SYNC_INTERVAL_SECONDS=30
