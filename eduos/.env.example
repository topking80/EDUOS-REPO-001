# EduOS District Edition: Docker Compose environment.
# Copy to .env (`cp .env.example .env`), chmod 600, and fill in every <...> value.
# Values in <> are placeholders: compose or the API refuses to start without real ones.
# Never commit .env.
#
# Reconstructed for 37.4.0 from src/config.js, docker-compose.yml and README.md
# because the file was missing from the release archive (audit finding F-1).

NODE_ENV=production

# --- Database (compose creates the roles; see db/init/00-eduos-roles.sh) ---
# Three distinct URL-safe secrets: openssl rand -hex 24
POSTGRES_SUPERUSER=eduos_admin
POSTGRES_PASSWORD=<openssl rand -hex 24>
EDUOS_OWNER_PASSWORD=<openssl rand -hex 24>
EDUOS_APP_PASSWORD=<openssl rand -hex 24>
# Under compose, each service sets its own DATABASE_URL (runtime role for the
# API, owner role for migrate/retention) and these values are ignored.
# Without Docker, point this at the runtime role (NOSUPERUSER NOBYPASSRLS, not an owner):
DATABASE_URL=postgres://eduos_app:<password>@<db-host>:5432/eduos
# Without Docker and with a remote database, also set DATABASE_SSL=true.
# Leave it unset under compose: the bundled database is internal and has no TLS.

# --- Public address ---
EDUOS_SITE_ADDRESS=<eduos.district.example>
PUBLIC_ORIGIN=https://<eduos.district.example>

# --- District identity provider (the issuer must be https in production) ---
OIDC_ISSUER=<https://idp.district.example>
OIDC_CLIENT_ID=<client id>
OIDC_CLIENT_SECRET=<client secret>
OIDC_REDIRECT_URI=https://<eduos.district.example>/auth/callback
# claim (default) | entra | trusted. See src/config.js.
OIDC_EMAIL_VERIFICATION=claim

# --- Edge network (Caddy) ---
# The API trusts forwarded headers only from the Caddy edge address.
# Keep exactly one TRUSTED_PROXY_IPS entry. It must match EDUOS_EDGE_IP on
# compose's edge_net (default subnet 172.30.0.0/24, edge at 172.30.0.2).
# If 172.30.0.0/24 collides with your network, change all four together.
EDUOS_EDGE_SUBNET=172.30.0.0/24
EDUOS_EDGE_IP=172.30.0.2
EDUOS_EDGE_IP_RANGE=172.30.0.128/25
TRUSTED_PROXY_IPS=172.30.0.2/32

# --- Optional ---
# Outbound webhooks stay disabled unless this is set (32+ characters).
# See docs/WEBHOOKS.md. In production also set WEBHOOK_ALLOWED_HOSTS (the
# receivers' domains, comma-separated) or WEBHOOK_ALLOW_ANY_PUBLIC_HOST=true.
# During a key rotation, WEBHOOK_SIGNING_KEY_PREVIOUS holds the old key.
# WEBHOOK_DISPATCH_INTERVAL_SECONDS (default 60, 0 = off) is how often the
# API itself sends due webhooks and retries.
WEBHOOK_SIGNING_KEY=
# OneRoster 1.2 and Ed-Fi connectors stay disabled unless this is set (32+
# characters). It encrypts connector client secrets; changing it means
# re-entering each connector's secret. Optionally pin which hosts connectors
# may reach (comma-separated; subdomains included).
INTEGRATIONS_KEY=
# Staff assistant (lesson drafts, summaries, writing feedback, operations
# brief). Runs on EduOS itself by default (no network). To use an external
# OpenAI-compatible model, set all of these; names and contact details are
# removed first. The superintendent still enables each tool for the district.
AI_PROVIDER=local
AI_ALLOW_EXTERNAL_PROVIDER=false
AI_PROVIDER_URL=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=
INTEGRATIONS_ALLOWED_HOSTS=
# EduOS mobile app (Flutter) sign-in through the system browser (RFC 8252).
# Leave empty to disable. The app's default is org.eduos.app:/oauth2redirect.
NATIVE_APP_REDIRECT_URIS=
# 37.6.0 well-being check-ins (docs/WELLBEING.md)
WELLBEING_RATE_LIMIT_PER_MIN=20
# GET /metrics is served only when this bearer token is set.
METRICS_TOKEN=
# 37.6.0 Credentials Wallet (docs/CREDENTIALS-WALLET.md). Unset = off.
# WALLET_ISSUER_SECRET=
# WALLET_SHARE_MAX_DAYS=90
# PUBLIC_VERIFY_RATE_LIMIT_PER_MIN=60
# Synthetic demo UI. Never enable in production.
EDUOS_DEMO_MODE=false
# Retention windows (RETENTION_*_DAYS) and rate limits default in src/config.js
# and src/retention.js. Override them here only when district policy requires it.
# 37.6.0 enrollment funnel (docs/ENROLLMENT.md)
ENROLLMENT_RATE_LIMIT_PER_MIN=30
RETENTION_ENROLLMENT_DOCUMENT_DAYS=90
RETENTION_ENROLLMENT_CLOSED_DAYS=365

# 37.7.0/37.7.1 commerce. Each district chooses its own payment options in
# Payments setup (superintendent or IT admin): PayPal, cards via Square or
# PayPal, Square, Bitcoin via the district's BTCPay Server, Venmo (via PayPal)
# and Cash App Pay (via Square), plus the no-money sandbox. Default is none.
# Live payments are OFF for every district until this is "true" AND the
# district saved live credentials; test/sandbox credentials work without it.
COMMERCE_LIVE_PAYMENTS_ENABLED=false
# Encrypts districts' processor credentials at rest (32+ chars, keep secret,
# never commit). Without it, credentials cannot be saved or used.
COMMERCE_SECRETS_KEY=
# Comma-separated hosts a district may point BTCPay Server at (self-hosted).
COMMERCE_ALLOWED_HOSTS=
# 37.7.1: processor calls never run inside a database transaction. If the API
# stops between reserving a payment and recording the processor's answer, it
# finishes the call later (same idempotency key): every
# COMMERCE_RECONCILE_INTERVAL_SECONDS (0 = off) for calls in flight longer than
# COMMERCE_RECONCILE_STALE_SECONDS.
COMMERCE_RECONCILE_INTERVAL_SECONDS=60
COMMERCE_RECONCILE_STALE_SECONDS=90
