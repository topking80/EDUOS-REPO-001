<?xml version="1.0" encoding="utf-8" ?>
<!-- PIN entry for a remote with no number keys: Up/Down picks the digit,
     Right or OK takes it, Left goes back. `done` gets the PIN when every slot is filled. -->
<component name="PinEntry" extends="Group">
  <interface>
    <field id="length" type="integer" value="4" />
    <field id="reset" type="boolean" alwaysNotify="true" onChange="onReset" />
    <field id="done" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PinEntry.brs" />
  <children>
    <Group id="slots" />
    <Label id="hint" translation="[0,190]" width="900" wrap="true" font="font:SmallSystemFont" color="0xB8C1D1FF"
      text="Up and Down change the number. Right or OK takes it. Left goes back." />
  </children>
</component>
