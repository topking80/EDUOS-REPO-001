<?xml version="1.0" encoding="utf-8" ?>
<!-- One HTTPS request to the district's EduOS server, off the render thread.
     Set `request` ({method, path, body?, auth?}) and control="RUN"; read `response`
     ({status, data, error}). status 0 means no connection or a timeout. -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <field id="response" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/shared/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
