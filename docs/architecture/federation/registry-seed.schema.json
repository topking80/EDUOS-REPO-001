      "type": "object",
      "required": [
        "states",
        "federal_districts",
        "commonwealths",
        "territories",
        "total_jurisdictions"
      ],
      "properties": {
        "states": {
          "const": 50
        },
        "federal_districts": {
          "type": "integer",
          "minimum": 0
        },
        "commonwealths": {
          "type": "integer",
          "minimum": 0
        },
        "territories": {
          "type": "integer",
          "minimum": 0
        },
        "total_jurisdictions": {
          "const": 54
        }
      },
      "additionalProperties": false
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 54,
