        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "country_code",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "state",
              "federal_district",
              "commonwealth",
              "territory"
            ]
          },
          "country_code": {
            "const": "US"
          },
